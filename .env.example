# 复制为 .env 后填写真实值。.env 已被 .gitignore 排除，切勿提交。

APP_ENV=dev
LOG_LEVEL=INFO

# ---- 登录与会话（生产必填，否则拒绝启动）----
# 单管理员密码，生产要求 ≥12 位且不能是 changeme 等常见口令。
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_PASSWORD=changeme
# 会话令牌签名密钥，生产要求 ≥32 位随机且**稳定**（改动会让所有人重新登录）。
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-insecure-session-secret
# 会话 Cookie 是否只走 HTTPS。内网 HTTPS 部署应置 true。
COOKIE_SECURE=false

# ---- 企业微信登录（网页授权 + 扫码登录）----
# 谁能进系统由「系统设置 → 登录与授权」里的部门树决定；
# 这一段只控制登录链路本身。默认关闭：升级后不会自动把全公司放进来。
# 提示：开关、前端地址、回调地址、拒绝方式都可在设置页修改（下一次登录即生效）。
WECOM_LOGIN_ENABLED=false
# 登录成功后回跳到前端的地址；留空时按访问域名自动推导（本机开发够用）。
# 生产建议显式配置，例如 https://zhoubao.example.com
WECOM_LOGIN_FRONTEND_URL=
# 企微回调地址。**必须与企微后台该自建应用配置的
# 「Web 网页授权及 JS-SDK 可信域名」完全一致（含端口）**，否则企微拒绝回调。
# 留空时按访问域名自动推导。例：
# WECOM_LOGIN_REDIRECT_URI=https://zhoubao.example.com/api/auth/wecom/callback
WECOM_LOGIN_REDIRECT_URI=
# 未授权成员的落地方式：show=显示原因与处理建议（默认）/ redirect=退回登录页。
WECOM_LOGIN_DENIED_MODE=show

# ---- Database ----
# SQLite（本地开发默认）
DB_URL=sqlite:///./data/app.db
# PostgreSQL（切换到 PG 时改为下面这种，并安装 psycopg[binary]）
# DB_URL=postgresql+psycopg2://user:password@localhost:5432/enterprise_ai

# ---- 企业微信 ----
# 管理后台 -> 我的企业 -> 企业信息 -> 企业ID
WECOM_CORP_ID=
# 自建应用的 Secret（不是「汇报」系统应用 secret，2023-12-01 起已停用）
WECOM_CORP_SECRET=
# 自建应用 AgentId。**企业微信登录（扫码/网页授权）必填**：缺了它企微直接报参数错误；
# 催交消息（message/send）也需要它。获取方式：管理后台 -> 应用管理 -> 自建应用。
WECOM_AGENT_ID=
# 只同步指定汇报表单；留空表示不过滤。
# 获取方式：管理后台 -> 汇报 -> 内容设置页 -> 点击汇报名称
WECOM_REPORT_TEMPLATE_IDS=[]
# 默认回溯天数
WECOM_SYNC_LOOKBACK_DAYS=30

# ---- 后台定时同步（首次部署默认值，后台设置页可覆盖）----
# 本地默认关闭；服务器开启后必须由常驻 app.worker 执行。
SYNC_AUTO_ENABLED=false
# 部门/员工校准间隔
SYNC_ORG_INTERVAL_HOURS=24
# 周报每周固定拉取时间；0=周一 ... 6=周日，按业务时区执行。
SYNC_REPORTS_WEEKDAY=4
SYNC_REPORTS_HOUR=19
SYNC_REPORTS_MINUTE=0
# 抓取发现新增或变更周报后，自动生成对应周期的全员 AI 总结。
SYNC_AUTO_PERIOD_SUMMARY_ENABLED=true
# 周报增量向前重叠天数，覆盖迟到提交和上游修改
SYNC_OVERLAP_DAYS=3

# ---- 自动催交（首次部署默认值，后台设置页可覆盖）----
# 默认关闭，避免开发或误部署时向真实员工发送企微消息。
REMIND_AUTO_ENABLED=false
# 0=周一 ... 6=周日
REMIND_AUTO_WEEKDAY=4
REMIND_AUTO_HOUR=21

# ---- 大模型 ----
# deepseek / fake（fake 用于无 Key 的本地开发与测试）
AI_PROVIDER=deepseek
# 留空即可：运行时以「系统设置」页保存的密钥为准（加密存库、保存后即时生效、无需重启）。
# 只有需要「环境变量兜底」时才在这里填；填了也不会覆盖设置页的值。
AI_API_KEY=
AI_MODEL=deepseek-chat
# 允许作为出站 AI 请求目标的**主机白名单**（JSON 数组）。
# 安全意义：设置页写进的 Base URL 是任意 URL，而下一次 AI 调用会把已保存的密钥
# 放进 Authorization 头发过去；因此目标主机必须由部署侧声明，不能在设置页随手改。
# 支持精确主机与 `.example.com` 形式的子域通配。
# 接入自建/代理网关时在此追加，例如：["api.deepseek.com", "gateway.internal"]
AI_ALLOWED_BASE_HOSTS=["api.deepseek.com"]

# ---- 后台 AI 分析 Worker ----
# 并发建议 5~10（2C4G）；轮询间隔秒；单篇最多尝试次数与失败退避基准秒
AI_WORKER_CONCURRENCY=5
AI_WORKER_POLL_SECONDS=3.0
AI_ANALYSIS_MAX_ATTEMPTS=3
AI_ANALYSIS_RETRY_BASE_SECONDS=60.0
# 历史分析投影（数据修复）的执行间隔；0=只在 Worker 启动时跑一次。
AI_BACKFILL_INTERVAL_SECONDS=3600
# 任务租约：超过该时长仍停在 RUNNING 的任务会被回收（防进程被杀后永久阻塞同步）。
WORKER_JOB_LEASE_MINUTES=90

# ---- 模型调用预算与重试 ----
# Agent 整个会话（全量上下文 + 历史 + 所有工具结果）的总输入字符上限。
# 必须大于 AI_AGENT_FULL_CONTEXT_CHARS（默认 60000），否则全量上下文自己就被砍。
AI_AGENT_MAX_CONTEXT_CHARS=90000
# 单次回复最大 token（0=不限制）；不设上限时超长输出会被上游截断，
# 解析失败后按次数重试、每次都计费。
AI_MAX_OUTPUT_TOKENS=2048
# 重试退避：base * 2^(N-1) 并叠加抖动，上限为 max。毫秒内连打三次限流没有意义。
AI_RETRY_BASE_SECONDS=1.5
AI_RETRY_MAX_SECONDS=20.0
# 流式请求是否显式索取 usage（OpenAI 兼容接口默认不返回，
# 不索取就永远拿不到 token 数）。个别上游不认该字段时置 false。
AI_STREAM_INCLUDE_USAGE=true

# ---- 登录限速 ----
# 单客户端窗口内允许的失败次数 / 全局失败次数（防换 IP 绕过）/ 窗口秒数。
LOGIN_MAX_FAILURES=5
LOGIN_MAX_GLOBAL_FAILURES=30
LOGIN_LOCKOUT_SECONDS=300

# ---- 设置页凭据的加密根密钥 ----
# 生产必填（Fernet key）。非生产留空时会自动生成 CONFIG_KEY_FILE 指向的密钥文件。
# 生成示例：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONFIG_ENCRYPTION_KEY=
CONFIG_KEY_FILE=data/.config_secret.key
